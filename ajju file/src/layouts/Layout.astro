---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro'; // <-- Naya Footer import kiya
import StickyBottomBar from '../components/StickyBottomBar.astro';

// Local font import (Google Fonts network request fix)
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
import '@fontsource/inter/800.css';
---
<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<meta name="description" content="Bangalore's trusted multi-brand RO water purifier repair, maintenance, installation, and AMC service provider. 60-min doorstep service with 90-day warranty." />
		<title>Service-center bangalore| Bangalore's Top Water Purifier Repair</title>
		
		<!-- Local Business Schema for SEO & Google Ads -->
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "LocalBusiness",
			"name": "Service Center Bangalore",
			"image": "https://Service-centerbangalore.com/logo.jpg",
			"@id": "https://Service-centerbangalore.com",
			"url": "https://Service-centerbangalore.com",
			"telephone": "+918069578358",
			"priceRange": "₹₹",
			"address": {
				"@type": "PostalAddress",
				"addressLocality": "Bangalore",
				"addressRegion": "KA",
				"addressCountry": "IN"
			},
			"aggregateRating": {
				"@type": "AggregateRating",
				"ratingValue": "4.7",
				"reviewCount": "12560"
			}
		}
		</script>
	</head>
	<body class="bg-white text-gray-800 font-sans antialiased pb-28 md:pb-0">
		
		<Header />
		
		<main class="min-h-screen">
			<slot /> <!-- Yahan aapke pages ka content aayega -->
		</main>

		<!-- Naya Footer Component yahan add kiya hai -->
		<Footer />

		<!-- Mobile ke liye Sticky Bottom Bar -->
		<StickyBottomBar />
	</body>
</html>